{
  "name": "governanator-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "moon run protocol:build core:build versioning:build query:build cli:build demo-ui:build storybook-addon:build mcp:build github-review:build fixture-attestation:build fixture-policy:build",
    "typecheck": "moon run workspace:typecheck",
    "lint": "moon run workspace:lint",
    "format": "oxfmt .",
    "format:check": "moon run workspace:format",
    "test": "moon run workspace:test",
    "check": "moon run workspace:check",
    "governanator": "bun packages/cli/src/main.ts",
    "protocol:generate": "bun scripts/protocol.ts",
    "protocol:check": "bun scripts/protocol.ts --check",
    "boundaries": "bun scripts/boundaries.ts && bun scripts/mcp-boundaries.ts && bun scripts/github-review-boundaries.ts && bun scripts/fixture-attestation-boundaries.ts && bun scripts/fixture-policy-boundaries.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun scripts/publish-disabled.ts",
    "storybook": "moon run storybook:dev",
    "storybook:build": "moon run storybook:build",
    "dogfood:report": "bun scripts/dogfood-report.ts",
    "addon:validator": "bun scripts/addon-validator.ts",
    "addon:check": "bun scripts/addon-validator.ts --check && bun scripts/addon-boundaries.ts",
    "release:demo": "bun scripts/release-demo.ts",
    "release:plan": "bun packages/cli/src/main.ts release plan --config governance/release.json",
    "mcp": "bun packages/mcp/src/main.ts",
    "mcp:smoke": "bun scripts/mcp-smoke.ts"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@moonrepo/cli": "2.6.4",
    "@opsydyn/oxlint-effect": "2.0.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "ajv": "8.20.0",
    "happy-dom": "20.10.6",
    "json-schema-to-typescript": "16.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.71.0",
    "publint": "0.3.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.4",
    "tar": "7.5.22",
    "tsdown": "0.22.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
