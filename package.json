{
  "name": "governanator-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "moon run protocol:build core:build versioning:build cli:build",
    "typecheck": "moon run workspace:typecheck",
    "lint": "moon run workspace:lint",
    "format": "oxfmt .",
    "format:check": "moon run workspace:format",
    "test": "moon run workspace:test",
    "check": "moon run workspace:check",
    "governanator": "bun packages/cli/src/main.ts",
    "protocol:generate": "bun scripts/protocol.ts",
    "protocol:check": "bun scripts/protocol.ts --check",
    "boundaries": "bun scripts/boundaries.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run check && bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@moonrepo/cli": "2.6.4",
    "@opsydyn/oxlint-effect": "2.0.1",
    "@types/bun": "1.4.4",
    "@types/semver": "7.8.0",
    "json-schema-to-typescript": "16.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.71.0",
    "publint": "0.3.21",
    "tsdown": "0.22.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
