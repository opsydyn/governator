{
  "name": "@opsydyn/governator-cli",
  "version": "0.2.0",
  "private": false,
  "description": "Bun CLI for design system governance, evidence, and release checks.",
  "homepage": "https://github.com/opsydyn/governator/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/opsydyn/governator/issues"
  },
  "license": "MIT",
  "author": "Alan Currie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/governator.git",
    "directory": "packages/cli"
  },
  "bin": {
    "governator": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@changesets/parse": "0.4.3",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.6",
    "@governator/core": "workspace:*",
    "@governator/operations": "workspace:*",
    "@governator/protocol": "workspace:*",
    "@governator/query": "workspace:*",
    "@governator/versioning": "workspace:*",
    "effect": "4.0.6"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
