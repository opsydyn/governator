{
  "name": "@governanator/cli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "governanator": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
