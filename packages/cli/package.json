    "provenance": true
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@governanator/core": "workspace:*",
    "@governanator/protocol": "workspace:*",
    "@governanator/versioning": "workspace:*",
    "effect": "4.0.6",
    "tar": "7.5.22",
    "yaml": "2.9.1"
  }
}
