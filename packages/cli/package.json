{
  "name": "@governator/cli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "governator": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@changesets/parse": "0.4.3",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@governator/core": "workspace:*",
    "@governator/protocol": "workspace:*",
    "@governator/query": "workspace:*",
    "@governator/versioning": "workspace:*",
    "effect": "4.0.6"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
