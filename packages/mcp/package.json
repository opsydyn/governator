{
  "name": "@governator/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Read-only MCP server for Governator governance snapshots.",
  "homepage": "https://github.com/opsydyn/governator/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/opsydyn/governator/issues"
  },
  "license": "MIT",
  "author": "Alan Currie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/governator.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "governator-mcp": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@changesets/parse": "0.4.3",
    "@modelcontextprotocol/server": "2.4.0",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@governator/query": "workspace:*",
    "effect": "4.0.6"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
