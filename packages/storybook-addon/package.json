{
  "name": "@opsydyn/storybook-addon-governator",
  "version": "0.1.0",
  "private": false,
  "description": "Storybook addon for design system governance and local metadata editing.",
  "homepage": "https://github.com/opsydyn/governator/tree/main/packages/storybook-addon#readme",
  "bugs": {
    "url": "https://github.com/opsydyn/governator/issues"
  },
  "license": "MIT",
  "author": "Alan Currie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/governator.git",
    "directory": "packages/storybook-addon"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": "./dist/preset.mjs",
    "./manager": "./dist/manager.js",
    "./tag-editor": "./dist/tag-editor.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun --bun tsdown && bun --bun tsdown --config tsdown.tag-editor.config.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "storybook": "10.6.4"
  },
  "storybook": {
    "displayName": "Governator Governance",
    "supportedFrameworks": [
      "react"
    ]
  }
}
