{
  "name": "@governator/storybook-addon",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": "./dist/preset.mjs",
    "./manager": "./dist/manager.js",
    "./tag-editor": "./dist/tag-editor.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun --bun tsdown && bun --bun tsdown --config tsdown.tag-editor.config.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "storybook": "10.6.4"
  },
  "storybook": {
    "displayName": "Governator Governance",
    "supportedFrameworks": [
      "react"
    ]
  }
}
