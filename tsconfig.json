{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@governanator/protocol": ["./packages/protocol/src/index.ts"],
      "@governanator/core": ["./packages/core/src/index.ts"],
      "@governanator/versioning": ["./packages/versioning/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["**/dist", "node_modules"]
}
