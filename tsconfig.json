{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@governator/protocol": ["./packages/protocol/src/index.ts"],
      "@governator/core": ["./packages/core/src/index.ts"],
      "@governator/versioning": ["./packages/versioning/src/index.ts"],
      "@example/ui": ["./packages/demo-ui/src/index.ts"],
      "@governator/query": ["./packages/query/src/index.ts"],
      "@governator/query/*": ["./packages/query/src/*.ts"],
      "@governator/fixture-attestation": ["./packages/fixture-attestation/src/index.ts"],
      "@governator/github-review": ["./packages/github-review/src/index.ts"],
      "@governator/fixture-policy": ["./packages/fixture-policy/src/index.ts"],
      "@governator/operations": ["./packages/operations/src/index.ts"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/**/.storybook/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["**/dist", "node_modules", "**/storybook-static", "apps/storybook-demo/public"]
}
